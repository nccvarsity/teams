{
  "name": "teams",
  "version": "1.0.0",
  "description": "Teams of Varsity!",
  "repository": "https://github.com/nccvarsity/teams",
  "author": "unknown",
  "private": false,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "next",
    "postinstall": "patch-package",
    "build": "next build",
    "build:analyze": "cross-env ANALYZE=true yarn build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "eslint src && stylelint '**/*.{css,scss}'",
    "tsc": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@bsmnt/scrollytelling": "^0.3.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-query": "^5.101.3",
    "@types/three": "^0.185.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "mousetrap": "^1.6.5",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "typescript": "^5.9.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@iconify/react": "^6.0.2",
    "@next/bundle-analyzer": "^16.2.10",
    "@next/eslint-plugin-next": "^16.2.10",
    "@types/css-font-loading-module": "^0.0.14",
    "@types/mousetrap": "^1.6.15",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "next-sitemap": "^4.2.3",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.20",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.9.6",
    "sass": "^1.101.3",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3"
  },
  "resolutions": {
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-portal": "^1.1.14",
    "@radix-ui/react-compose-refs": "^1.1.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "yarn": "1.x"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "arrowParens": "always",
    "tabWidth": 2,
    "printWidth": 80,
    "trailingComma": "none",
    "endOfLine": "auto"
  },
  "stylelint": {
    "ignoreFiles": [
      "**/*.{ts,tsx,js,jsx}",
      "out/**",
      ".next/**",
      "node_modules/**"
    ],
    "extends": [
      "stylelint-config-standard",
      "stylelint-config-standard-scss",
      "stylelint-prettier/recommended"
    ],
    "plugins": [
      "stylelint-prettier"
    ],
    "rules": {
      "scss/at-rule-no-unknown": [
        true,
        {
          "ignoreAtRules": [
            "tailwind",
            "layer",
            "apply",
            "variants",
            "responsive",
            "screen",
            "include",
            "for",
            "mixin",
            "if",
            "else",
            "warn",
            "return",
            "function",
            "use",
            "each"
          ]
        }
      ],
      "selector-pseudo-class-no-unknown": [
        true,
        {
          "ignorePseudoClasses": [
            "global"
          ]
        }
      ],
      "property-no-unknown": [
        true,
        {
          "ignoreProperties": [
            "font-named-instance"
          ]
        }
      ],
      "no-descending-specificity": null,
      "length-zero-no-unit": null,
      "alpha-value-notation": null,
      "selector-id-pattern": null,
      "selector-class-pattern": null,
      "property-no-vendor-prefix": null,
      "value-no-vendor-prefix": null,
      "media-feature-range-notation": null,
      "keyframe-selector-notation": null,
      "declaration-block-no-redundant-longhand-properties": null,
      "scss/no-global-function-names": null,
      "scss/double-slash-comment-empty-line-before": null
    }
  }
}
